# Optional. Leave unset for local development — vite.config.ts proxies
# /api to http://127.0.0.1:3000, so no base URL is needed.
#
# Set this only when the API lives on a different origin in production,
# e.g. https://api.gdgoc.example.com. That origin MUST be listed in the
# backend's CORS_ORIGINS, otherwise the browser will block the response.
VITE_API_BASE_URL=
