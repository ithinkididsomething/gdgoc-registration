node_modules/

# Personal data — never commit the roster or submitted registrations.
data/students.json
data/registrations.json
# The CSV export holds the same names and phone numbers as the log.
registrations.csv
# Derived by scripts/import-google-form.js from a real Google Forms export.
# needs-enrollment.csv contains real names and Google account addresses.
data/students.backup.json
data/needs-enrollment.csv
data/import-report.json
data/*.tmp

.env
.env.*
!.env.example

npm-debug.log*
.DS_Store
Thumbs.db

# Service account keys. This is the half that actually talks to Firestore, so it
# gets its own belt-and-braces rule. See the root .gitignore for why one of these
# committed is unrecoverable without rotating the key.
gdgregs-*.json
*-firebase-adminsdk-*.json
*service-account*.json
*service_account*.json
google-credentials*.json
gcp-key*.json

# Real Google Form URLs. A form response link is a bearer credential - whoever
# holds it can submit - so these belong in the deployment env only
# (VERTICAL_FORM_URLS), never in git. This repo is PUBLIC, so committing one
# publishes it to the whole web permanently.
config/verticals.local.js
config/verticals.local.json
