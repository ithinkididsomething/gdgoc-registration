# Backend configuration. OPTIONAL in development - every value below has a
# working default and the server starts with no .env file at all. Copy this to
# .env only if you need to change something.
#
# There is no .env loader in this project: the server reads real environment
# variables. Set them in your shell, your host's dashboard, or a process manager.

# --- Network -----------------------------------------------------------------
# Keep PORT in sync with the proxy target in the frontend's vite.config.ts.
PORT=3000
HOST=0.0.0.0

# --- Modes -------------------------------------------------------------------
# "production" hides error detail and makes CORS fail closed.
NODE_ENV=development

# --- CORS --------------------------------------------------------------------
# In development the server already allows any localhost port, so leave this
# unset. In PRODUCTION it is REQUIRED - the server refuses to start without it
# rather than opening the endpoints that hand out internal Google Form links.
# Comma-separated, exact origins, no trailing slash:
#   CORS_ORIGINS=https://gdgoc.example.com,https://www.example.com
# CORS_ORIGINS=

# --- Google Form URLs (REQUIRED in production) ------------------------------
# THE TEN FORM RESPONSE LINKS L live HERE, and only here. They are intentionally
# absent from the repository: this repo is PUBLIC, so a committed form link is
# published to the entire web and any web-enabled AI, permanently and
# irreversibly (git history keeps it even after the file is edited).
#
# A form response link is a bearer credential - anyone holding it can submit to
# that form - so treat it like a password.
#
# Format: one JSON object, vertical key -> full viewform URL. Keys must match
# VERTICAL_KEYS in config/verticals.js exactly (lowercase, "social media" has a
# space). Only docs.google.com / forms.google.com are accepted, and do NOT add
# "?embedded=true" - the frontend appends that itself.
#
# Every one of the ten is required in production; an incomplete map refuses to
# start rather than showing a student a broken form.
#
# VERTICAL_FORM_URLS={"content":"https://docs.google.com/forms/d/e/<FORM_ID_1>/viewform","creatives":"https://docs.google.com/forms/d/e/<FORM_ID_2>/viewform","operations":"https://docs.google.com/forms/d/e/<FORM_ID_3>/viewform","social media":"https://docs.google.com/forms/d/e/<FORM_ID_4>/viewform","design":"https://docs.google.com/forms/d/e/<FORM_ID_5>/viewform","production":"https://docs.google.com/forms/d/e/<FORM_ID_6>/viewform","pr":"https://docs.google.com/forms/d/e/<FORM_ID_7>/viewform","sponsorship":"https://docs.google.com/forms/d/e/<FORM_ID_8>/viewform","marketing":"https://docs.google.com/forms/d/e/<FORM_ID_9>/viewform","technical":"https://docs.google.com/forms/d/e/<FORM_ID_10>/viewform"}
#
# For local development without exporting that every shell, drop the same shape
# into config/verticals.local.js (gitignored):
#   module.exports = { technical: "https://docs.google.com/forms/d/e/<FORM_ID>/viewform" };

# --- Data --------------------------------------------------------------------
# Which engine stores registrations. `file` keeps a JSON array under DATA_DIR and
# is the only implemented option; anything else fails at startup with the list of
# valid names. A typo here used to be invisible until the first submission.
# REGISTRATION_STORE=file

# --- Firestore (REGISTRATION_STORE=firestore) -------------------------------
# Auth comes from Application Default Credentials. On a laptop that means
# pointing this at the downloaded key file:
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\gdgregs-xxxxxxxx.json
#
# On a managed host (Render, Railway, Cloud Run) attach the service account to
# the service instead and leave this unset — a key file on the host is a key
# file that can leak.
#
# NEVER set FIREBASE_EMULATOR_HOST in production. The SDK would send every read
# and write to a local emulator instead of Firestore.
# FIREBASE_EMULATOR_HOST=127.0.0.1:8080

# Which Firestore database. Firestore addresses databases as
# projects/<project>/databases/<id>, and a project can hold more than one. The
# console's create button offers `(default)` but nothing forces you to accept it,
# and the Admin SDK's bare getFirestore() ONLY means `(default)` — so a project
# whose database has any other name fails with a bare NOT_FOUND.
#
# This project's database is `(default)`, so production needs no override.
# Only set this if you create a differently-named database.
# FIREBASE_DATABASE_ID=(default)

# Where students.json and registrations.json live. Point this elsewhere to run
# against a different roster without touching the repo.
# Ignored entirely by a non-file driver, which has no filesystem.
# DATA_DIR=./data

# How often the roster is re-read from disk. This is what lets you drop in the
# real student list without restarting the server.
STUDENTS_CACHE_TTL_MS=30000

# --- Roster on a deploy host ------------------------------------------------
# data/students.json is gitignored, so a checkout-based deploy ships WITHOUT it
# and every lookup silently returns found:false. `npm run build` (which hosts
# like Render and Railway run automatically) calls scripts/seed-roster.js to
# put it back. Unset all three below and that build step is a no-op, which is
# correct for local dev where the file is already on disk.
#
# Pick whichever your host can give you. They are tried in this order, and the
# first one set wins:
#
# 1. Path to a real roster JSON file. Preferred where the host can mount one
#    (Render secret files, a Docker image, an SSH volume). No size limit.
# STUDENTS_FILE_PATH=/run/secrets/students.json
#
# 2. Path to a packed payload from: npm run encode-roster
#    Use this when you have a file but not a conveniently sized variable -
#    Windows caps one env var at 32,767 chars and the payload is ~39,000.
# STUDENTS_JSON_B64_FILE=./dist/roster.b64.txt
#
# 3. The packed payload inline, for hosts whose dashboard only takes
#    environment variables (Vercel). Vercel caps ONE variable at 64KB, which is
#    why the payload is brotli-compressed: 241KB of JSON becomes ~39KB.
#    Generate it with: npm run encode-roster
# STUDENTS_JSON_B64=b...

# Refuse new registrations once the log passes this size, so a runaway client
# cannot fill the disk or force a huge JSON parse per write.
MAX_STORE_BYTES=8388608

# --- Spreadsheet export --------------------------------------------------
# Shared secret that unlocks GET /api/registrations.csv, which serves the
# whole log as CSV for Excel / Google Sheets. UNSET means the route returns
# 404 and does not exist - it hands out every student's name, phone and email,
# so it must be opt-in. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Then in Sheets: =IMPORTDATA("https://your-domain/api/registrations.csv?key=<token>")
# Keep it out of git and out of shared docs - it is the only thing guarding
# the log.
# EXPORT_TOKEN=

# Per-IP cap on CSV fetches, per window. Higher than register, because a
# spreadsheet polling =IMPORTDATA() is legitimate.
RATE_LIMIT_MAX_EXPORT=60

# --- Limits ------------------------------------------------------------------
# A registration is a tiny object; 64kb is generous.
BODY_LIMIT=64kb

# Per-IP rate limits, per window.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_LOOKUP=30
RATE_LIMIT_MAX_REGISTER=10

# Number of trusted reverse proxies in front of this service, used only to
# resolve the client IP for rate limiting. 0 means ignore X-Forwarded-For
# entirely, so a client cannot spoof its IP to dodge the limiter. Raise it to
# 1 behind exactly one proxy (nginx, Render, a platform load balancer).
TRUST_PROXY_HOPS=0