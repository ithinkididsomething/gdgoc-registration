# Backend configuration. OPTIONAL in development - every value below has a
# working default and the server starts with no .env file at all. Copy this to
# .env only if you need to change something.
#
# There is no .env loader in this project: the server reads real environment
# variables. Set them in your shell, your host's dashboard, or a process manager.

# --- Network -----------------------------------------------------------------
# Keep PORT in sync with the proxy target in the frontend's vite.config.ts.
PORT=3000
HOST=0.0.0.0

# --- Modes -------------------------------------------------------------------
# "production" hides error detail and makes CORS fail closed.
NODE_ENV=development

# --- CORS --------------------------------------------------------------------
# In development the server already allows any localhost port, so leave this
# unset. In PRODUCTION it is REQUIRED - the server refuses to start without it
# rather than opening the endpoints that hand out internal Google Form links.
# Comma-separated, exact origins, no trailing slash:
#   CORS_ORIGINS=https://gdgoc.example.com,https://www.example.com
# CORS_ORIGINS=

# --- Data --------------------------------------------------------------------
# Where students.json and registrations.json live. Point this elsewhere to run
# against a different roster without touching the repo.
# DATA_DIR=./data

# How often the roster is re-read from disk. This is what lets you drop in the
# real student list without restarting the server.
STUDENTS_CACHE_TTL_MS=30000

# Refuse new registrations once the log passes this size, so a runaway client
  # cannot fill the disk or force a huge JSON parse per write.
  MAX_STORE_BYTES=8388608
  
  # --- Spreadsheet export --------------------------------------------------
  # Shared secret that unlocks GET /api/registrations.csv, which serves the
  # whole log as CSV for Excel / Google Sheets. UNSET means the route returns
  # 404 and does not exist - it hands out every student's name, phone and email,
  # so it must be opt-in. Generate one with:
  #   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
  # Then in Sheets: =IMPORTDATA("https://your-domain/api/registrations.csv?key=<token>")
  # Keep it out of git and out of shared docs - it is the only thing guarding
  # the log.
  # EXPORT_TOKEN=
  
  # Per-IP cap on CSV fetches, per window. Higher than register, because a
  # spreadsheet polling =IMPORTDATA() is legitimate.
  RATE_LIMIT_MAX_EXPORT=60

# --- Limits ------------------------------------------------------------------
# A registration is a tiny object; 64kb is generous.
BODY_LIMIT=64kb

# Per-IP rate limits, per window.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_LOOKUP=30
RATE_LIMIT_MAX_REGISTER=10

# Number of trusted reverse proxies in front of this service, used only to
# resolve the client IP for rate limiting. 0 means ignore X-Forwarded-For
# entirely, so a client cannot spoof its IP to dodge the limiter. Raise it to
# 1 behind exactly one proxy (nginx, Render, a platform load balancer).
TRUST_PROXY_HOPS=0